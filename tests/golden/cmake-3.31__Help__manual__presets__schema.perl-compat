ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV10}.{anyOf}.3.{description}."An object representing the type and value of the variable. Available in version 10 and higher."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV10}.{anyOf}.3.{required}.0."value"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV10}.{anyOf}.3.{type}."object"
