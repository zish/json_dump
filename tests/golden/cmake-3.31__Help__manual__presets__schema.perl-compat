ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV10}.{description}."An optional object specifying tests to include by test index. Available in version 10 and higher."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV10}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV10}.{type}."object"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{description}."An optional object specifying tests to include by test index. Available in version 2 and higher."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{end}.{description}."An optional integer specifying a test index to stop testing at."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{end}.{type}."integer"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{specificTests}.{description}."An optional array of integers specifying specific test indices to run."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{specificTests}.{items}.{description}."An integer specifying the test to run by index."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{specificTests}.{items}.{type}."integer"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{specificTests}.{type}."array"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{start}.{description}."An optional integer specifying a test index to start testing at."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{start}.{type}."integer"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{stride}.{description}."An optional integer specifying the increment."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{properties}.{stride}.{type}."integer"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsObjectV2}.{type}."object"
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsStringV2}.{description}."An optional string specifying a file with the command line syntax for --tests-information. Available in version 2 and higher."
ROOT.{definitions}.{testPresetsFilterIncludeIndexAsStringV2}.{type}."string"
