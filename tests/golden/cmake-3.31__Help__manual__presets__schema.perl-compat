ROOT.{definitions}.{configurePresetsArchitectureV1}.{anyOf}.1.{type}."object"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsBooleanV1}.{description}."A boolean representing the value of the variable. Equivalent to "TRUE" or "FALSE"."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsBooleanV1}.{type}."boolean"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsNullV1}.{description}."Setting a variable to null causes it to not be set, even if a value was inherited from another preset."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsNullV1}.{type}."null"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV10}.{description}."An optional object representing the cache variables for generators that support it. Available in version 10 and higher."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV10}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV10}.{type}."object"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{description}."An optional object representing the cache variables for generators that support it. Available in version 1 and higher."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{properties}.{type}.{description}."An optional string representing the type of the variable. It should be BOOL, FILEPATH, PATH, STRING, or INTERNAL."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{properties}.{type}.{type}."string"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{properties}.{value}.{anyOf}.0.{description}."A required boolean representing the value of the variable. Equivalent to "TRUE" or "FALSE"."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{properties}.{value}.{anyOf}.0.{type}."boolean"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{properties}.{value}.{anyOf}.1.{description}."A required string representing the value of the variable. This field supports macro expansion."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{properties}.{value}.{anyOf}.1.{type}."string"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsObjectV1}.{type}."object"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsStringV1}.{description}."A string representing the value of the variable (which supports macro expansion)."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesAsStringV1}.{type}."string"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV10}.{anyOf}.0.{$ref}."#/definitions/configurePresetsCacheVariablesAdditionalPropertiesAsNullV1"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV10}.{anyOf}.1.{$ref}."#/definitions/configurePresetsCacheVariablesAdditionalPropertiesAsBooleanV1"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV10}.{anyOf}.2.{$ref}."#/definitions/configurePresetsCacheVariablesAdditionalPropertiesAsStringV1"
