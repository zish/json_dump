ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{type}."array"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{vendor}.{description}."An optional map containing vendor-specific information. CMake does not interpret the contents of this field except to verify that it is a map if it does exist. However, it should follow the same conventions as the root-level vendor field."
