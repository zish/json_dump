ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV1}.{anyOf}.3.{description}."An object representing the type and value of the variable. Available in version 1 and higher."
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV1}.{anyOf}.3.{required}.0."value"
ROOT.{definitions}.{configurePresetsCacheVariablesAdditionalPropertiesV1}.{anyOf}.3.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV10}.{description}."An optional array of configure preset objects. Available in version 10 and higher."
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{description}."A configure preset object. Available in version 10 and higher."
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{properties}.{debug}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{properties}.{errors}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{properties}.{graphviz}.{description}."An optional string specifying the path to graphviz dot file. Available in version 10 and higher."
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{properties}.{graphviz}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{properties}.{trace}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{properties}.{warnings}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{configurePresetsItemsV10}.{items}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV10}.{type}."array"
ROOT.{definitions}.{configurePresetsItemsV1}.{description}."An optional array of configure preset objects. Available in version 1 and higher."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{description}."A configure preset object. Available in version 1 and higher."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{binaryDir}.{description}."An optional string representing the path to the output binary directory. This field supports macro expansion. If a relative path is specified, it is calculated relative to the source directory. If binaryDir is not specified, it must be inherited from the inherits preset (unless this preset is hidden)."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{binaryDir}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{cacheVariables}.{description}."An optional map of cache variables. The key is the variable name (which must not be an empty string). Cache variables are inherited through the inherits field, and the preset's variables will be the union of its own cacheVariables and the cacheVariables from all its parents. If multiple presets in this union define the same variable, the standard rules of inherits are applied."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{cacheVariables}.{propertyNames}.{pattern}."^.+$"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{cacheVariables}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{cmakeExecutable}.{description}."An optional string representing the path to the CMake executable to use for this preset. This is reserved for use by IDEs, and is not used by CMake itself. IDEs that use this field should expand any macros in it."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{cmakeExecutable}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{description}."An optional object specifying debug options."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{properties}.{find}.{description}."An optional boolean. Setting this to true is equivalent to passing --debug-find on the command line."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{properties}.{find}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{properties}.{output}.{description}."An optional boolean. Setting this to true is equivalent to passing --debug-output on the command line."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{properties}.{output}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{properties}.{tryCompile}.{description}."An optional boolean. Setting this to true is equivalent to passing --debug-trycompile on the command line."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{properties}.{tryCompile}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{debug}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{description}.{description}."An optional string with a human-friendly description of the preset."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{description}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{displayName}.{description}."An optional string with a human-friendly name of the preset."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{displayName}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.0.{description}."Setting a variable to null causes it to not be set, even if a value was inherited from another preset."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.0.{type}."null"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.1.{description}."A string representing the value of the variable."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.1.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{environment}.{description}."An optional map of environment variables. The key is the variable name (which must not be an empty string). Each variable is set regardless of whether or not a value was given to it by the process's environment. This field supports macro expansion, and environment variables in this map may reference each other, and may be listed in any order, as long as such references do not cause a cycle (for example,if ENV_1 is $env{ENV_2}, ENV_2 may not be $env{ENV_1}.) Environment variables are inherited through the inherits field, and the preset's environment will be the union of its own environment and the environment from all its parents. If multiple presets in this union define the same variable, the standard rules of inherits are applied. Setting a variable to null causes it to not be set, even if a value was inherited from another preset."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{environment}.{propertyNames}.{pattern}."^.+$"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{environment}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{errors}.{description}."An optional object specifying errors."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{errors}.{properties}.{deprecated}.{description}."An optional boolean. Equivalent to passing -Werror=deprecated or -Wno-error=deprecated on the command line. This may not be set to true if warnings.deprecated is set to false."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{errors}.{properties}.{deprecated}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{errors}.{properties}.{dev}.{description}."An optional boolean. Equivalent to passing -Werror=dev or -Wno-error=dev on the command line. This may not be set to true if warnings.dev is set to false."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{errors}.{properties}.{dev}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{errors}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{generator}.{description}."An optional string representing the generator to use for the preset. If generator is not specified, it must be inherited from the inherits preset (unless this preset is hidden). Note that for Visual Studio generators, unlike in the command line -G argument, you cannot include the platform name in the generator name. Use the architecture field instead."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{generator}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{hidden}.{description}."An optional boolean specifying whether or not a preset should be hidden. If a preset is hidden, it cannot be used in the --preset= argument, will not show up in the CMake GUI, and does not have to have a valid generator or binaryDir, even from inheritance. Hidden presets are intended to be used as a base for other presets to inherit via the inherits field."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{hidden}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.0.{description}."An optional string representing the name of the preset to inherit from."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.0.{minLength}."1"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.0.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.1.{description}."An optional array of strings representing the names of presets to inherit from. The preset will inherit all of the fields from the inherits presets by default (except name, hidden, inherits, description, and displayName), but can override them as desired. If multiple inherits presets provide conflicting values for the same field, the earlier preset in the inherits list will be preferred. Presets in CMakePresets.json must not inherit from presets in CMakeUserPresets.json."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{description}."An optional string representing the name of the preset to inherit from."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{minLength}."1"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{inherits}.{anyOf}.1.{type}."array"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{name}.{description}."A required string representing the machine-friendly name of the preset. This identifier is used in the --preset argument. There must not be two presets in the union of CMakePresets.json and CMakeUserPresets.json in the same directory with the same name."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{name}.{minLength}."1"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{name}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{vendor}.{description}."An optional map containing vendor-specific information. CMake does not interpret the contents of this field except to verify that it is a map if it does exist. However, it should follow the same conventions as the root-level vendor field. If vendors use their own per-preset vendor field, they should implement inheritance in a sensible manner when appropriate."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{vendor}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{description}."An optional object specifying warnings."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{deprecated}.{description}."An optional boolean. Equivalent to passing -Wdeprecated or -Wno-deprecated on the command line. This may not be set to false if errors.deprecated is set to true."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{deprecated}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{dev}.{description}."An optional boolean. Equivalent to passing -Wdev or -Wno-dev on the command line. This may not be set to false if errors.dev is set to true."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{dev}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{systemVars}.{description}."An optional boolean. Setting this to true is equivalent to passing --check-system-vars on the command line."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{systemVars}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{uninitialized}.{description}."An optional boolean. Setting this to true is equivalent to passing --warn-uninitialized on the command line."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{uninitialized}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{unusedCli}.{description}."An optional boolean. Setting this to false is equivalent to passing --no-warn-unused-cli on the command line."
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{properties}.{unusedCli}.{type}."boolean"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{properties}.{warnings}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV1}.{items}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV1}.{type}."array"
ROOT.{definitions}.{configurePresetsItemsV3}.{description}."An optional array of configure preset objects. Available in version 3 and higher."
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{description}."A configure preset object. Available in version 3 and higher."
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{binaryDir}.{description}."An optional string representing the path to the output binary directory. This field supports macro expansion. If a relative path is specified, it is calculated relative to the source directory. If binaryDir is not specified, the path is calculated using regular methods."
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{binaryDir}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{generator}.{description}."An optional string representing the generator to use for the preset. If generator is not specified, the normal generator discovery procedure is used. Note that for Visual Studio generators, unlike in the command line -G argument, you cannot include the platform name in the generator name. Use the architecture field instead."
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{generator}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{installDir}.{description}."An optional string representing the path to the installation directory. This field supports macro expansion. If a relative path is specified, it is calculated relative to the source directory."
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{installDir}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{toolchainFile}.{description}."An optional string representing the path to the toolchain file. This field supports macro expansion. If a relative path is specified, it is calculated relative to the build directory, and if not found, relative to the source directory."
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{properties}.{toolchainFile}.{type}."string"
ROOT.{definitions}.{configurePresetsItemsV3}.{items}.{type}."object"
ROOT.{definitions}.{configurePresetsItemsV3}.{type}."array"
ROOT.{definitions}.{configurePresetsItemsV7}.{description}."An optional array of configure preset objects. Available in version 7 and higher."
ROOT.{definitions}.{configurePresetsItemsV7}.{items}.{description}."A configure preset object. Available in version 7 and higher."
ROOT.{definitions}.{configurePresetsItemsV7}.{items}.{properties}.{trace}.{description}."An optional object specifying trace options."
ROOT.{definitions}.{configurePresetsItemsV7}.{items}.{properties}.{trace}.{properties}.{format}.{description}."An optional string that specifies the trace output format."
ROOT.{definitions}.{configurePresetsItemsV7}.{items}.{properties}.{trace}.{properties}.{format}.{enum}.0."human"
