ROOT.{definitions}.{workflowPresetsItemsV6}.{description}."An optional array of workflow preset objects. Used to execute configure, build, test, and package presets in order. Available in version 6 and higher."
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{description}.{description}."An optional string with a human-friendly description of the preset."
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{description}.{type}."string"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{displayName}.{description}."An optional string with a human-friendly name of the preset."
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{displayName}.{type}."string"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{name}.{description}."A required string representing the machine-friendly name of the preset. This identifier is used in the --preset argument. There must not be two presets (configure, build, test, package, or workflow) in the union of CMakePresets.json and CMakeUserPresets.json in the same directory with the same name."
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{name}.{minLength}."1"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{name}.{type}."string"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{description}."A required array of objects describing the steps of the workflow. The first step must be a configure preset, and all subsequent steps must be non-configure presets whose configurePreset field matches the starting configure preset."
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{items}.{properties}.{name}.{description}."A required string representing the name of the configure, build, test, or package preset to run as this workflow step."
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{items}.{properties}.{name}.{minLength}."1"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{items}.{properties}.{name}.{type}."string"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{items}.{properties}.{type}.{description}."A required string. The first step must be configure. Subsequent steps must be either build, test, or package."
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{items}.{properties}.{type}.{enum}.0."configure"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{items}.{properties}.{type}.{enum}.1."build"
ROOT.{definitions}.{workflowPresetsItemsV6}.{items}.{properties}.{steps}.{items}.{properties}.{type}.{enum}.2."test"
