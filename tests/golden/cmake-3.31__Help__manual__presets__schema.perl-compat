ROOT.{definitions}.{configurePresetsItemsV7}.{items}.{properties}.{trace}.{properties}.{mode}.{enum}.0."on"
ROOT.{definitions}.{configurePresetsItemsV7}.{items}.{properties}.{trace}.{properties}.{mode}.{enum}.1."off"
