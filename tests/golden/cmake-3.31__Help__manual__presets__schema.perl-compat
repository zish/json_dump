ROOT.{$schema}."http://json-schema.org/draft-07/schema#"
ROOT.{definitions}.{$comment}.{anyOf}.0.{description}."The single-line comment"
ROOT.{definitions}.{$comment}.{anyOf}.0.{type}."string"
ROOT.{definitions}.{$comment}.{anyOf}.1.{description}."The multi-line comment"
ROOT.{definitions}.{$comment}.{anyOf}.1.{items}.{description}."One line of the multi-line comment"
ROOT.{definitions}.{$comment}.{anyOf}.1.{items}.{type}."string"
ROOT.{definitions}.{$comment}.{anyOf}.1.{minItems}."1"
ROOT.{definitions}.{$comment}.{anyOf}.1.{type}."array"
ROOT.{definitions}.{$schema}.{description}."The schema against which to verify this document."
ROOT.{definitions}.{$schema}.{format}."uri-reference"
ROOT.{definitions}.{$schema}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV10}.{description}."An optional array of build preset objects. Used to specify arguments to cmake --build. Available in version 10 and higher."
ROOT.{definitions}.{buildPresetsItemsV10}.{items}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{buildPresetsItemsV10}.{items}.{type}."object"
ROOT.{definitions}.{buildPresetsItemsV10}.{type}."array"
ROOT.{definitions}.{buildPresetsItemsV2}.{description}."An optional array of build preset objects. Used to specify arguments to cmake --build. Available in version 2 and higher."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{cleanFirst}.{description}."An optional boolean. If true, equivalent to passing --clean-first on the command line."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{cleanFirst}.{type}."boolean"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{configuration}.{description}."An optional string. Equivalent to passing --config on the command line."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{configuration}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{configurePreset}.{description}."An optional string specifying the name of a configure preset to associate with this build preset. If configurePreset is not specified, it must be inherited from the inherits preset (unless this preset is hidden). The build tree directory is inferred from the configure preset."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{configurePreset}.{minLength}."1"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{configurePreset}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{description}.{description}."An optional string with a human-friendly description of the preset."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{description}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{displayName}.{description}."An optional string with a human-friendly name of the preset."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{displayName}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.0.{description}."Setting a variable to null causes it to not be set, even if a value was inherited from another preset."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.0.{type}."null"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.1.{description}."A string representing the value of the variable."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.1.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{environment}.{description}."An optional map of environment variables. The key is the variable name (which must not be an empty string). Each variable is set regardless of whether or not a value was given to it by the process's environment. This field supports macro expansion, and environment variables in this map may reference each other, and may be listed in any order, as long as such references do not cause a cycle (for example,if ENV_1 is $env{ENV_2}, ENV_2 may not be $env{ENV_1}.) Environment variables are inherited through the inherits field, and the preset's environment will be the union of its own environment and the environment from all its parents. If multiple presets in this union define the same variable, the standard rules of inherits are applied. Setting a variable to null causes it to not be set, even if a value was inherited from another preset."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{environment}.{propertyNames}.{pattern}."^.+$"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{environment}.{type}."object"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{hidden}.{description}."An optional boolean specifying whether or not a preset should be hidden. If a preset is hidden, it cannot be used in the --preset argument and does not have to have a valid configurePreset, even from inheritance. Hidden presets are intended to be used as a base for other presets to inherit via the inherits field."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{hidden}.{type}."boolean"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inheritConfigureEnvironment}.{description}."An optional boolean that defaults to true. If true, the environment variables from the associated configure preset are inherited after all inherited build preset environments, but before environment variables explicitly specified in this build preset."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inheritConfigureEnvironment}.{type}."boolean"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.0.{description}."An optional string representing the name of the build preset to inherit from."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.0.{minLength}."1"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.0.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.1.{description}."An optional array of strings representing the names of build presets to inherit from. The preset will inherit all of the fields from the inherits presets by default (except name, hidden, inherits, description, and displayName), but can override them as desired. If multiple inherits presets provide conflicting values for the same field, the earlier preset in the inherits list will be preferred. Presets in CMakePresets.json must not inherit from presets in CMakeUserPresets.json."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{description}."An optional string representing the name of the preset to inherit from."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{minLength}."1"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{inherits}.{anyOf}.1.{type}."array"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{jobs}.{description}."An optional integer. Equivalent to passing --parallel or -j on the command line."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{jobs}.{type}."integer"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{name}.{description}."A required string representing the machine-friendly name of the preset. This identifier is used in the --preset argument. There must not be two presets (configure, build, test, package, or workflow) in the union of CMakePresets.json and CMakeUserPresets.json in the same directory with the same name."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{name}.{minLength}."1"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{name}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{nativeToolOptions}.{description}."An optional array of strings. Equivalent to passing options after -- on the command line."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{nativeToolOptions}.{items}.{description}."An optional string representing an option to pass after -- on the command line."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{nativeToolOptions}.{items}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{nativeToolOptions}.{type}."array"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{targets}.{anyOf}.0.{description}."An optional string. Equivalent to passing --target or -t on the command line. Vendors may ignore the targets property or hide build presets that explicitly specify targets."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{targets}.{anyOf}.0.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{targets}.{anyOf}.1.{description}."An optional array of strings. Equivalent to passing --target or -t on the command line. Vendors may ignore the targets property or hide build presets that explicitly specify targets."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{targets}.{anyOf}.1.{items}.{description}."An optional string. Equivalent to passing --target or -t on the command line. Vendors may ignore the targets property or hide build presets that explicitly specify targets."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{targets}.{anyOf}.1.{items}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{targets}.{anyOf}.1.{type}."array"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{vendor}.{description}."An optional map containing vendor-specific information. CMake does not interpret the contents of this field except to verify that it is a map if it does exist. However, it should follow the same conventions as the root-level vendor field. If vendors use their own per-preset vendor field, they should implement inheritance in a sensible manner when appropriate."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{vendor}.{type}."object"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{verbose}.{description}."An optional boolean. If true, equivalent to passing --verbose on the command line."
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{properties}.{verbose}.{type}."boolean"
ROOT.{definitions}.{buildPresetsItemsV2}.{items}.{type}."object"
ROOT.{definitions}.{buildPresetsItemsV2}.{type}."array"
ROOT.{definitions}.{buildPresetsItemsV3}.{description}."An optional array of build preset objects. Used to specify arguments to cmake --build. Available in version 3 and higher."
ROOT.{definitions}.{buildPresetsItemsV3}.{type}."array"
ROOT.{definitions}.{buildPresetsItemsV4}.{description}."An optional array of build preset objects. Used to specify arguments to cmake --build. Available in version 4 and higher."
ROOT.{definitions}.{buildPresetsItemsV4}.{items}.{properties}.{resolvePackageReferences}.{description}."An optional string specifying the package resolve behavior. Valid values are "on" (packages are resolved prior to the build), "off" (packages are not resolved prior to the build), and "only" (packages are resolved, but no build will be performed)."
ROOT.{definitions}.{buildPresetsItemsV4}.{items}.{properties}.{resolvePackageReferences}.{enum}.0."on"
ROOT.{definitions}.{buildPresetsItemsV4}.{items}.{properties}.{resolvePackageReferences}.{enum}.1."off"
ROOT.{definitions}.{buildPresetsItemsV4}.{items}.{properties}.{resolvePackageReferences}.{enum}.2."only"
ROOT.{definitions}.{buildPresetsItemsV4}.{items}.{properties}.{resolvePackageReferences}.{type}."string"
ROOT.{definitions}.{buildPresetsItemsV4}.{items}.{type}."object"
ROOT.{definitions}.{buildPresetsItemsV4}.{type}."array"
