ROOT.{definitions}.{configurePresetsArchitectureAsObjectV10}.{description}."An optional object representing the platform for generators that support it. Available in version 10 and higher."
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV10}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV10}.{type}."object"
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{description}."An optional object representing the platform for generators that support it. Available in version 1 and higher."
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{properties}.{strategy}.{description}."An optional string telling CMake how to handle the field. Valid values are: "set" Set the respective value. This will result in an error for generators that do not support the respective field. "external" Do not set the value, even if the generator supports it. This is useful if, for example, a preset uses the Ninja generator, and an IDE knows how to set up the Visual C++ environment from the architecture and toolset fields. In that case, CMake will ignore the field, but the IDE can use them to set up the environment before invoking CMake."
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{properties}.{strategy}.{enum}.0."set"
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{properties}.{strategy}.{enum}.1."external"
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{properties}.{strategy}.{type}."string"
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{properties}.{value}.{description}."An optional string representing the value."
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{properties}.{value}.{type}."string"
ROOT.{definitions}.{configurePresetsArchitectureAsObjectV1}.{type}."object"
ROOT.{definitions}.{configurePresetsArchitectureAsStringV1}.{description}."An optional string representing the platform for generators that support it."
ROOT.{definitions}.{configurePresetsArchitectureAsStringV1}.{type}."string"
ROOT.{definitions}.{configurePresetsArchitectureV10}.{anyOf}.0.{$ref}."#/definitions/configurePresetsArchitectureAsStringV1"
