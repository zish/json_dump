ROOT.{definitions}.{packagePresetsItemsV10}.{items}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{packagePresetsItemsV10}.{items}.{properties}.{output}.{properties}.{$comment}.{$ref}."#/definitions/$comment"
ROOT.{definitions}.{packagePresetsItemsV10}.{items}.{properties}.{output}.{type}."object"
ROOT.{definitions}.{packagePresetsItemsV10}.{items}.{type}."object"
ROOT.{definitions}.{packagePresetsItemsV10}.{type}."array"
ROOT.{definitions}.{packagePresetsItemsV6}.{description}."An optional array of package preset objects. Used to specify arguments to cpack. Available in version 6 and higher."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configFile}.{description}."An optional string representing the config file for CPack to use."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configFile}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configurations}.{description}."An optional list of strings representing build configurations for CPack to package."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configurations}.{items}.{description}."An optional string representing the name of the configuration to use."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configurations}.{items}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configurations}.{type}."array"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configurePreset}.{description}."An optional string specifying the name of a configure preset to associate with this package preset. If configurePreset is not specified, it must be inherited from the inherits preset (unless this preset is hidden). The build tree directory is inferred from the configure preset."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configurePreset}.{minLength}."1"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{configurePreset}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{description}.{description}."An optional string with a human-friendly description of the preset."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{description}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{displayName}.{description}."An optional string with a human-friendly name of the preset."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{displayName}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.0.{description}."Setting a variable to null causes it to not be set, even if a value was inherited from another preset."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.0.{type}."null"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.1.{description}."A string representing the value of the variable."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{environment}.{additionalProperties}.{anyOf}.1.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{environment}.{description}."An optional map of environment variables. The key is the variable name (which must not be an empty string). Each variable is set regardless of whether or not a value was given to it by the process's environment. This field supports macro expansion, and environment variables in this map may reference each other, and may be listed in any order, as long as such references do not cause a cycle (for example,if ENV_1 is $env{ENV_2}, ENV_2 may not be $env{ENV_1}.) Environment variables are inherited through the inherits field, and the preset's environment will be the union of its own environment and the environment from all its parents. If multiple presets in this union define the same variable, the standard rules of inherits are applied. Setting a variable to null causes it to not be set, even if a value was inherited from another preset."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{environment}.{propertyNames}.{pattern}."^.+$"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{environment}.{type}."object"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{generators}.{description}."An optional list of strings representing generators for CPack to use."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{generators}.{items}.{description}."An optional string representing the name of the CPack generator to use."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{generators}.{items}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{generators}.{type}."array"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{hidden}.{description}."An optional boolean specifying whether or not a preset should be hidden. If a preset is hidden, it cannot be used in the --preset argument and does not have to have a valid configurePreset, even from inheritance. Hidden presets are intended to be used as a base for other presets to inherit via the inherits field."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{hidden}.{type}."boolean"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inheritConfigureEnvironment}.{description}."An optional boolean that defaults to true. If true, the environment variables from the associated configure preset are inherited after all inherited package preset environments, but before environment variables explicitly specified in this package preset."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inheritConfigureEnvironment}.{type}."boolean"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.0.{description}."An optional string representing the name of the package preset to inherit from."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.0.{minLength}."1"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.0.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.1.{description}."An optional array of strings representing the names of package presets to inherit from. The preset will inherit all of the fields from the inherits presets by default (except name, hidden, inherits, description, and displayName), but can override them as desired. If multiple inherits presets provide conflicting values for the same field, the earlier preset in the inherits list will be preferred. Presets in CMakePresets.json must not inherit from presets in CMakeUserPresets.json."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{description}."An optional string representing the name of the preset to inherit from."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{minLength}."1"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.1.{items}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{inherits}.{anyOf}.1.{type}."array"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{name}.{description}."A required string representing the machine-friendly name of the preset. This identifier is used in the --preset argument. There must not be two presets (configure, build, test, package, or workflow) in the union of CMakePresets.json and CMakeUserPresets.json in the same directory with the same name."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{name}.{minLength}."1"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{name}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{output}.{description}."An optional object specifying output options."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{output}.{properties}.{debug}.{description}."An optional boolean specifying whether or not to print debug information. A value of true is equivalent to passing --debug on the command line."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{output}.{properties}.{debug}.{type}."boolean"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{output}.{properties}.{verbose}.{description}."An optional boolean specifying whether or not to print verbosely. A value of true is equivalent to passing --verbose on the command line."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{output}.{properties}.{verbose}.{type}."boolean"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{output}.{type}."object"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{packageDirectory}.{description}."An optional string representing the directory in which to place the package."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{packageDirectory}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{packageName}.{description}."An optional string representing the package name."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{packageName}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{packageVersion}.{description}."An optional string representing the package version."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{packageVersion}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{variables}.{description}."An optional map of variables to pass to CPack, equivalent to -D arguments. Each key is the name of a variable, and the value is the string to assign to that variable."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{variables}.{items}.{description}."An optional string representing the value of the variable."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{variables}.{items}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{variables}.{type}."object"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{vendorName}.{description}."An optional string representing the vendor name."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{vendorName}.{type}."string"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{vendor}.{description}."An optional map containing vendor-specific information. CMake does not interpret the contents of this field except to verify that it is a map if it does exist. However, it should follow the same conventions as the root-level vendor field. If vendors use their own per-preset vendor field, they should implement inheritance in a sensible manner when appropriate."
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{properties}.{vendor}.{type}."object"
ROOT.{definitions}.{packagePresetsItemsV6}.{items}.{type}."object"
ROOT.{definitions}.{packagePresetsItemsV6}.{type}."array"
